NEXT_PUBLIC_SUPABASE_URL=https://yxpnlatvsqstizdhjtmv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Model-powered laboratory Research agent. Gemini is the default provider.
NODRA_MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_server_side_gemini_key
NODRA_AGENT_MODEL=gemini-2.5-flash

# Optional alternative provider; not required when using Gemini.
OPENAI_API_KEY=your_optional_server_side_openai_key

# Server-only master secret used to derive a distinct HMAC key for every agent.
# Generate at least 32 random bytes; never expose this with a NEXT_PUBLIC_ prefix.
NODRA_GATEWAY_SIGNING_SECRET=replace_with_at_least_32_random_characters
