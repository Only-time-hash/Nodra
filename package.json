{
  "name": "nodra",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "node --experimental-strip-types --test packages/*/src/*.test.ts apps/web/lib/*.test.ts",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:database": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_workspace_isolation.sql",
    "test:coverage": "node --experimental-test-coverage --experimental-strip-types --test packages/*/src/*.test.ts apps/web/lib/*.test.ts",
    "test:python": "PYTHONPATH=packages/python-sdk/src python -m unittest discover -s packages/python-sdk/tests -p \"test_*.py\"",
    "test:agent": "node scripts/test-finance-agent.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/containment",
    "packages/policy",
    "packages/recovery",
    "packages/runtime",
    "packages/provenance",
    "packages/sdk",
    "packages/cli"
  ]
}
